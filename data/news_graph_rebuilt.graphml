    <node id="article:7991a197116767e1dfc12cc000857070">
      <data key="d1">article</data>
      <data key="d2">7991a197116767e1dfc12cc000857070</data>
      <data key="d11">DBS का शेयर आज क्यों गिर रहा है?</data>
      <data key="d3">hi</data>
      <data key="d4">DBS का शेयर आज क्यों गिर रहा है?</data>
      <data key="d5">investing_hi</data>
      <data key="d6">2026-11-05 02:16:50</data>
      <data key="d12">https://hi.investing.com/news/stock-market-news/article-93CH-757236</data>
