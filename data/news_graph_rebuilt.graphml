    <edge source="entity:org:पत_तन_प_त_पर_वहन_और_जलम_र_ग" target="event:factory_announcement:article:048afcd46b2385612d3a85a0e365efcb" id="0">
      <data key="d14">ANNOUNCED</data>
      <data key="d18">article:048afcd46b2385612d3a85a0e365efcb</data>
      <data key="d15">0.7</data>
      <data key="d16">Sarbanand Sonowal ने पुरी में International Cruise Terminal बनाने का किया ऐलान पुरी, तीन नवंबर केंद्रीय पत्तन, पोत परिवहन और जलमार्ग मंत्री सर्बानंद सोनोवाल ने मंगलवार को पुरी में 1,500 करोड़ रुपये की अनुमानित लागत से एक अंतरराष्ट्रीय क्रूज टर्मिनल विकसित करने की घोषणा की।</data>
      <data key="d17">rule_based</data>
    </edge>
    <edge source="event:factory_announcement:article:048afcd46b2385612d3a85a0e365efcb" target="entity:loc:प_र" id="0">
      <data key="d14">LOCATED_IN</data>
